<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="MAIN" Id="{4C86F9CE-87A0-4B16-9B69-B43855927BF4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // Local init guard so the fixture starts from a known, non-zero-ish state
    // the very first cycle (optional -- tests write their own values).
    bInit : BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// One-time seed of the fixture (optional; the tests overwrite these).
IF bInit THEN
    bInit := FALSE;
    GVL_Test.TestBool        := FALSE;
    GVL_Test.TestInt         := 0;
    GVL_Test.TestDint        := 0;
    GVL_Test.TestReal        := 0.0;
    GVL_Test.TestLreal       := 0.0;
    GVL_Test.TestString      := '';
    GVL_Test.Setpoint        := 0.0;
    GVL_Test.Counter         := 0;
    GVL_Test.TestStruct.Id      := 0;
    GVL_Test.TestStruct.Value   := 0.0;
    GVL_Test.TestStruct.Enabled := FALSE;
    GVL_Test.TestStruct.Label   := '';
END_IF

// Liveness counter: increment every PLC cycle so clients can prove the program
// is scanning and measure read/subscription update timing. Wraps naturally at
// the DINT boundary.
GVL_Test.Counter := GVL_Test.Counter + 1;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
