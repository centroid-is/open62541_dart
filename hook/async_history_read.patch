+#ifdef UA_ENABLE_HISTORIZING
+
+/***************/
+/* HistoryRead */
+/***************/
+
+UA_StatusCode
+allocateHistoryReadResults(UA_HistoryReadResponse *response, size_t resultsSize,
+                           UA_AsyncResponse **ar, UA_AsyncOperation **op) {
+    response->results = (UA_HistoryReadResult*)
+        allocateResultsArray(&UA_TYPES[UA_TYPES_HISTORYREADRESULT],
+                             resultsSize, ar, op);
+    if(!response->results)
+        return UA_STATUSCODE_BADOUTOFMEMORY;
+    response->resultsSize = resultsSize;
+    return UA_STATUSCODE_GOOD;
+}
+
+UA_Boolean
+persistAsyncHistoryRead(UA_Server *server, UA_Session *session,
+                        UA_HistoryReadResponse *response,
+                        UA_AsyncResponse *ar, UA_AsyncOperation *op) {
+    if(response->responseHeader.serviceResult != UA_STATUSCODE_GOODCOMPLETESASYNCHRONOUSLY)
+        return true;
+    response->responseHeader.serviceResult = UA_STATUSCODE_GOOD;
+    op->context.historyReadResultsSize = response->resultsSize;
+    persistAsyncResponseOperation(server, op, UA_ASYNCOPERATIONTYPE_HISTORYREAD_REQUEST,
+                                  ar, response->results);
+    if(ar->opCountdown == 0)
+        return true; /* Refused (queue full), the results carry the status */
+    ar->responseType = &UA_TYPES[UA_TYPES_HISTORYREADRESPONSE];
+    persistAsyncResponse(server, session, response, ar);
+    return false;
+}
+
+UA_StatusCode
+UA_Server_setAsyncHistoryReadResult(UA_Server *server, UA_HistoryReadResult *results) {
+    lockServer(server);
+    UA_AsyncManager *am = &server->asyncManager;
+    UA_AsyncOperation *op = NULL;
+    TAILQ_FOREACH(op, &am->waitingOps, pointers) {
+        if(op->asyncOperationType == UA_ASYNCOPERATIONTYPE_HISTORYREAD_REQUEST &&
+           op->output.historyRead == results) {
+            processOperationResult(server, op);
+            break;
+        }
+    }
+    unlockServer(server);
+    return (op) ? UA_STATUSCODE_GOOD : UA_STATUSCODE_BADNOTFOUND;
+}
+
+#endif /* UA_ENABLE_HISTORIZING */
+
