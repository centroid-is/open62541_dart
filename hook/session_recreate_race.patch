 static void
 responseActivateSession(UA_Client *client, void *userdata,
                         UA_UInt32 requestId, void *response) {
     UA_LOCK_ASSERT(&client->clientMutex);
 
     UA_ActivateSessionResponse *ar = (UA_ActivateSessionResponse*)response;
+
+    /* The request was cancelled locally because the SecureChannel closed
+     * before the response arrived (BadSecureChannelClosed comes from
+     * __Client_AsyncService_removeAll on the channel-close path, not from the
+     * server). This is not an activation failure: the Session still exists on
+     * the server -- it was created, only its activation is unconfirmed.
+     *
+     * Set the state to CREATED, not CLOSED, on this "closed" status code on
+     * purpose. CREATED makes connectActivity re-ActivateSession the existing
+     * Session on the reconnected channel -- the same thing open62541 already
+     * does for an ACTIVATED Session, which the CLOSING branch of
+     * __Client_networkCallback demotes to CREATED (not CLOSED) precisely so it
+     * is re-activated rather than recreated. CLOSED would instead discard a
+     * still-valid server-side Session and force a fresh CreateSession, which is
+     * the path whose CreateSession-nonce race the ua_client.c half of this
+     * change fixes -- so keeping the Session and re-activating it is both more
+     * correct and avoids re-entering that path. If the server did discard the
+     * Session during the drop, the retried ActivateSession comes back
+     * BadSessionIdInvalid and the branch below creates a new one. */
+    if(ar->responseHeader.serviceResult == UA_STATUSCODE_BADSECURECHANNELCLOSED) {
+        client->sessionState = UA_SESSIONSTATE_CREATED;
+        return;
+    }
+
     if(ar->responseHeader.serviceResult != UA_STATUSCODE_GOOD) {
         /* Activating the Session failed */
         cleanupSession(client);
 
         /* Configuration option to not create a new Session */
         if(client->config.noNewSession) {
             UA_LOG_ERROR(client->config.logging, UA_LOGCATEGORY_CLIENT,
                          "Session cannot be activated with StatusCode %s. "
                          "The client is configured not to create a new Session.",
                          UA_StatusCode_name(ar->responseHeader.serviceResult));
             setConnectStatus(client, ar->responseHeader.serviceResult);
             return;
