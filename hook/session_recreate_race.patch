 static void
 createSessionCallback(UA_Client *client, void *userdata,
                       UA_UInt32 requestId, void *response) {
     UA_LOCK_ASSERT(&client->clientMutex);
 
     UA_CreateSessionResponse *csr = (UA_CreateSessionResponse*)response;
     UA_StatusCode res = csr->responseHeader.serviceResult;
+
+    /* The request was cancelled locally because the SecureChannel closed
+     * before the response arrived. That is not a handshake failure: the
+     * SecureChannel reconnects on its own and the next connect iteration sends
+     * a fresh CreateSession. Do not set the (fatal) connectStatus. */
+    if(res == UA_STATUSCODE_BADSECURECHANNELCLOSED) {
+        client->sessionState = UA_SESSIONSTATE_CLOSED;
+        return;
+    }
+
     if(res != UA_STATUSCODE_GOOD)
         goto cleanup;
 
     if(client->channel.securityMode == UA_MESSAGESECURITYMODE_SIGN ||
        client->channel.securityMode == UA_MESSAGESECURITYMODE_SIGNANDENCRYPT) {
         /* Verify the session response was created with the same certificate as
          * the SecureChannel */
         if(!UA_ByteString_equal(&csr->serverCertificate,
                                 &client->channel.remoteCertificate)) {
             res = UA_STATUSCODE_BADCERTIFICATEINVALID;
             goto cleanup;
         }
