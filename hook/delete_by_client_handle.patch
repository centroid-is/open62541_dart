+/* UA62541_DART_DELETE_BY_HANDLE: identify the MonitoredItems a
+ * DeleteMonitoredItemsRequest refers to by their clientHandle, snapshotted at
+ * send time, instead of matching monitoredItemIds against the live tree when
+ * the response is processed. monitoredItemIds are server-assigned and may be
+ * recycled the moment the server frees them; if a subsequent
+ * CreateMonitoredItems response re-using one of the ids is processed before
+ * this delete's response (out-of-order service completion on the server is
+ * legal), matching by id would remove the NEW item from the local tree while
+ * the server keeps publishing it — every notification is then dropped with
+ * "Could not process a notification with clienthandle N" and the value
+ * freezes silently. clientHandles are client-assigned and monotonically
+ * unique for the lifetime of the UA_Client, so they cannot collide. */
+typedef struct {
+    UA_DeleteMonitoredItemsRequest *request;
+    UA_UInt32 *clientHandles; /* 1:1 with request->monitoredItemIds;
+                               * 0 = no local item existed at send time */
+} DeleteMonitoredItemsData;
+
+static void *
+MonitoredItem_findByID(void *data, UA_Client_MonitoredItem *mon);
+
+/* Resolve each requested monitoredItemId to the clientHandle of the local
+ * item it refers to right now. Must be called with the client lock held,
+ * before the request is put on the wire. Returns NULL on allocation failure
+ * (the caller then falls back to matching by id). */
+static UA_UInt32 *
+MonitoredItems_snapshotHandles(UA_Client *client, UA_UInt32 subscriptionId,
+                               const UA_UInt32 *monitoredItemIds, size_t size) {
+    UA_UInt32 *handles = (UA_UInt32*)
+        UA_calloc(size > 0 ? size : 1, sizeof(UA_UInt32));
+    if(!handles)
+        return NULL;
+    UA_Client_Subscription *sub = findSubscriptionById(client, subscriptionId);
+    if(!sub)
+        return handles;
+    for(size_t i = 0; i < size; i++) {
+        UA_UInt32 id = monitoredItemIds[i];
+        UA_Client_MonitoredItem *mon = (UA_Client_MonitoredItem*)
+            ZIP_ITER(MonitorItemsTree, &sub->monitoredItems,
+                     MonitoredItem_findByID, &id);
+        if(mon)
+            handles[i] = mon->parameters.clientHandle;
+    }
+    return handles;
+}
